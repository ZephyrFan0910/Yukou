<!-- 静态 Banner -->
<div class="banner-container">
    <div class="banner-bg" style="background-image: url('../images/shop/banner/shop.jpg');" data-aos="fade-down"></div>

</div>

<!-- 主体内容区 -->
<div class="container">
    <!-- 1. 文创产品列表（网格展示） -->
    <div class=”section”>
        <div class=”section-header” data-aos=”fade-up”>
            <h2 class=”section-title”>🛍️ 精选文创产品</h2>
            <div class=”title-decoration”></div>
        </div>
        <p class=”section-subtitle” data-aos=”fade-up” data-aos-delay=”100”>基于玉扣纸”经久不蛀、温润如玉”特性，结合畲族文化元素设计</p>
        <div class="product-grid">
            <!-- 产品卡片 7 -->
            <div class="product-card" data-aos="fade-up" data-aos-delay="0">
                <div class="product-image">
                    <img src="../images/shop/koukou_notebook.jpg" alt="扣扣笔记本">
                </div>
                <div class="product-info">
                    <h3>”扣扣“形象笔记本</h3>
                    <p class="product-desc">封面采用国风「扣扣」IP 形象与传统凤凰纹设计，内页选用加厚非遗玉扣纸，书写不洇墨，兼具日常实用与文化收藏价值。</p>
                    <div class="product-price">¥20.00</div>
                    <div class="product-sold">已售 1,203</div>
                    <button class="cart-btn" data-id="6"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 8 -->
            <div class="product-card" data-aos="fade-up" data-aos-delay="100">
                <div class="product-image">
                    <img src="../images/shop/koukou_hang.jpg" alt="扣扣挂件">
                </div>
                <div class="product-info">
                    <h3>“扣扣”形象挂件</h3>
                    <p class="product-desc">以非遗玉扣纸为基底，雕刻「扣扣」IP 形象与传统凤凰纹样，搭配流苏挂饰，兼具便携装饰性与非遗文化传播价值。</p>
                    <div class="product-price">¥15.00</div>
                    <div class="product-sold">已售 1,203</div>
                    <button class="cart-btn" data-id="6"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 1 -->
            <div class="product-card" data-aos="zoom-in" data-aos-delay="200">
                <div class="product-image">
                    <img src="../images/shop/creative-notebook.jpg" alt="畲族纹样玉扣纸笔记本">
                </div>
                <div class="product-info">
                    <h3>畲族纹样玉扣纸笔记本</h3>
                    <p class="product-desc">封面印畲族传统“凤凰纹”，内页纯手工玉扣纸，细腻不洇墨。</p>
                    <div class="product-price">¥30.00</div>
                    <div class="product-sold">已售 2,341</div>
                    <button class="cart-btn" data-id="1"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 2 -->
            <div class="product-card" data-aos="zoom-in" data-aos-delay="300">
                <div class="product-image">
                    <img src="../images/shop/creative-lamp.jpg" alt="竹纸透光艺术灯具">
                </div>
                <div class="product-info">
                    <h3>竹纸透光艺术灯具</h3>
                    <p class="product-desc">灯罩采用多层玉扣纸叠加，激光雕刻畲族图腾，灯光柔和温暖。</p>
                    <div class="product-price">¥50.00</div>
                    <div class="product-sold">已售 987</div>
                    <button class="cart-btn" data-id="2"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 3 -->
            <div class="product-card" data-aos="fade-right" data-aos-delay="0">
                <div class="product-image">
                    <img src="../images/shop/creative-diy.jpg" alt="古法造纸DIY材料包">
                </div>
                <div class="product-info">
                    <h3>古法造纸DIY材料包</h3>
                    <p class="product-desc">迷你竹帘、纸浆、染料、工具套装+教学手册，零基础可操作。</p>
                    <div class="product-price">¥25.00</div>
                    <div class="product-sold">已售 1,256</div>
                    <button class="cart-btn" data-id="3"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 4 -->
            <div class="product-card" data-aos="fade-left" data-aos-delay="100">
                <div class="product-image">
                    <img src="../images/shop/creative-scroll.jpg" alt="玉扣纸书法卷轴">
                </div>
                <div class="product-info">
                    <h3>玉扣纸书法卷轴</h3>
                    <p class="product-desc">1.2米/1.8米长卷，搭配实木轴头，与省级书协联名款。</p>
                    <div class="product-price">¥25.00</div>
                    <div class="product-sold">已售 532</div>
                    <button class="cart-btn" data-id="4"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 5 -->
            <div class="product-card" data-aos="flip-left" data-aos-delay="200">
                <div class="product-image">
                    <img src="../images/shop/creative-album.jpg" alt="非遗主题纪念相册">
                </div>
                <div class="product-info">
                    <h3>非遗主题纪念相册</h3>
                    <p class="product-desc">内页玉扣纸，封面竹编工艺，耐老化无化学异味。</p>
                    <div class="product-price">¥35.00</div>
                    <div class="product-sold">已售 764</div>
                    <button class="cart-btn" data-id="5"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>
            <!-- 产品卡片 6 -->
            <div class="product-card" data-aos="fade-up" data-aos-delay="300">
                <div class="product-image">
                    <img src="../images/shop/creative-puzzle.jpg" alt="纸艺拼图">
                </div>
                <div class="product-info">
                    <h3>畲乡造纸场景拼图</h3>
                    <p class="product-desc">100片/300片，加厚玉扣纸材质，兼具娱乐与文化传播。</p>
                    <div class="product-price">¥40.00</div>
                    <div class="product-sold">已售 1,203</div>
                    <button class="cart-btn" data-id="6"><i class="fas fa-cart-plus"></i> 加入购物车</button>
                </div>
            </div>

        </div>
